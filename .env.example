# Server Port
PORT=3000

# MongoDB Connection String (Replace with your MongoDB Atlas or local MongoDB URI)
# Example: mongodb+srv://username:password@cluster0.mongodb.net/proposal_app?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/proposal_app

# Passwords
ADMIN_PASS=admin777
VIP_PASS=1910
SENGVE_NAME=Sengve Rongpharpi

# ==========================================
# 📱 Automated Phone Alert Settings (October 19, 12:00 AM Midnight)
# ==========================================
# Phone number to receive the message (e.g. +91XXXXXXXXXX)
ALERT_PHONE_NUMBER=

# Your live website domain / public URL (e.g. https://your-domain.com or http://localhost:3000)
APP_PUBLIC_URL=http://localhost:3000

# Custom message text (defaults to below if left blank)
ALERT_MESSAGE=Wishing you a very Happy 26th Birthday, Sengve! 🎂✨ Handcrafted with love from Amitson in Chandigarh — please open your special link:

# SMS / Messaging Provider: 'whatsapp' (100% Free Automated WhatsApp via Web QR Link), 'twilio', or 'fast2sms'
SMS_PROVIDER=whatsapp

# --- CallMeBot Configuration (100% Free Automated WhatsApp) ---
# To get your free API key in 10 seconds:
# 1. Add phone number +34 644 44 20 62 in WhatsApp
# 2. Send message: "I allow callmebot to send me messages"
# 3. CallMeBot will immediately reply with your free API key!
CALLMEBOT_API_KEY=

# --- Twilio Configuration (if SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Set to 'true' if sending via Twilio WhatsApp instead of standard SMS
TWILIO_WHATSAPP=false

# --- Fast2SMS Configuration (if SMS_PROVIDER=fast2sms) ---
FAST2SMS_API_KEY=
